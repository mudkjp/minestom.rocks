{
    "name": "minestom-rocks",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "packageManager": "bun@1.3.4",
    "scripts": {
        "dev": "vite dev",
        "build": "bun install && vite build",
        "preview": "vite build && wrangler pages dev .svelte-kit/cloudflare",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
    },
    "imports": {
        "#lib": "./src/lib/index.ts",
        "#lib/*": "./src/lib/*"
    },
    "devDependencies": {
        "@sveltejs/adapter-cloudflare": "^8.0.3",
        "@sveltejs/kit": "^3.4.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^26.6.6",
        "@types/wicg-file-system-access": "^2023.10.7",
        "svelte": "^5.58.0",
        "svelte-check": "^4.7.8",
        "tailwindcss": "^4.3.5",
        "typescript": "~6",
        "vite": "^8.3.8",
        "wrangler": "^4.165.0"
    },
    "dependencies": {
        "shiki": "^4.6.0"
    }
}
